---
import dm400 from "@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url";
import dm700 from "@fontsource/dm-sans/files/dm-sans-latin-700-normal.woff2?url";
import serif400 from "@fontsource/source-serif-4/files/source-serif-4-latin-400-normal.woff2?url";
import "../styles/global.css";
import { PARTY_COLORS } from "@contracts/constants";
import { manifest, dataUrl, eu } from "../lib/release";

interface Props {
  title: string;
  description: string;
  /** Sökväg för OG-bild (genereras vid bygget), t.ex. /og/parti/m.png */
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** EU-valets sidor: egen meny, egen release och eget datalager (eu2029/). */
  eu?: boolean;
}
const { title, description, jsonLd, noindex = false, eu: isEu = false } = Astro.props;
// OG-bilden genereras vid bygget per sida (scripts/og.mjs): /og/<sökväg>.png
const ogImage = Astro.props.ogImage ?? `/og${Astro.url.pathname === "/" ? "/index" : Astro.url.pathname.replace(/\/$/, "")}.png`;
const m = isEu ? eu.manifest() : manifest();
const dataBase = isEu ? `${dataUrl()}/eu2029` : dataUrl();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === "Mandatorn" ? title : `${title} – Mandatorn`;
const partyVars = Object.entries(PARTY_COLORS).map(([p, c]) => `--party-${p}:${c}`).join(";");
const plausible = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
// Två nivåer: själva prognosen först, resten dämpat till höger.
const navMain = [
  ["/", "Översikt"], ["/mandat/", "Mandat"], ["/sannolikheter/", "Sannolikheter"],
  ["/valkretsar/", "Valkretsar"], ["/kommuner/", "Kommuner"], ["/regioner/", "Regioner"],
];
const navMore = [
  ["/partier/", "Partier"], ["/institut/", "Institut"], ["/valnatt/", "Valnatt"],
  ["/data/", "Öppen data"], ["/eu/", "EU-valet"], ["/om/", "Metod"],
];
const euMain = [
  ["/eu/", "Översikt"], ["/eu/partier/", "Partier"], ["/eu/sannolikheter/", "Sannolikheter"], ["/eu/valnatt/", "Valnatt"],
];
const euMore = [["/eu/data/", "Öppen data"], ["/eu/metod/", "Metod"], ["/", "Riksdagsvalet"]];
const [menuMain, menuMore] = isEu ? [euMain, euMore] : [navMain, navMore];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === "/" || href === "/eu/" ? path === href : path.startsWith(href));
// Valsedelsband: riksdag gul (standard), region blå, kommun grå, EU mörkblå.
const ballot = isEu || path.startsWith("/eu/") ? "eu" : /^\/regioner?\//.test(path) ? "rf" : /^\/kommun(er)?\//.test(path) ? "kf" : "rd";
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="Mandatorn" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${fullTitle}: ${description}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />
    <meta name="mandatorn:release" content={m.release} />
    <meta name="mandatorn:data" content={dataBase} />
    <link rel="preload" href={dm400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dm700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serif400} as="font" type="font/woff2" crossorigin />
    {/* font-display: optional — typsnittet byts aldrig mitt i visningen (ingen layoutförskjutning). */}
    <style set:html={`@font-face{font-family:"DM Sans";font-style:normal;font-weight:400;font-display:optional;src:url(${dm400}) format("woff2")}@font-face{font-family:"DM Sans";font-style:normal;font-weight:700;font-display:optional;src:url(${dm700}) format("woff2")}@font-face{font-family:"Source Serif 4";font-style:normal;font-weight:400;font-display:optional;src:url(${serif400}) format("woff2")}:root{${partyVars}}`}></style>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {plausible && <script defer data-domain={plausible} src="https://plausible.io/js/script.js"></script>}
  </head>
  <body>
    <a class="skip" href="#main">Hoppa till innehållet</a>
    <header class="site-header" data-val={ballot}>
      <div class="wrap">
        <a class="brand" href="/">Mandatorn</a>
        <nav class="nav" aria-label="Huvudmeny">
          <div class="nav-main">
            {menuMain.map(([href, label]) => <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a>)}
          </div>
          <div class="nav-more">
            {menuMore.map(([href, label]) => <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a>)}
          </div>
        </nav>
      </div>
    </header>
    <div class="wrap" id="release-banner" aria-live="polite"></div>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          Mandatorn är en oberoende statistisk modell, inte ett officiellt valresultat.
          Data: opinionsmätningar via <a href="https://github.com/MansMeg/SwedishPolls">SwedishPolls</a> (CC0),
          valresultat från <a href="https://www.val.se">Valmyndigheten</a>.
        </p>
        <p>
          <a href="/data/">Öppen data</a> (CC BY-NC 4.0) · <a href="/licens/">Licens</a> ·
          <a href="/om/">Metod</a> · <a href="/status/">Status</a> · <a href="/integritet/">Integritet</a> ·
          Release <span class="num">{m.release.slice(0, 12)}</span> ({m.generatedAt.slice(0, 10)})
        </p>
      </div>
    </footer>
    <script>
      import { releaseStatus, ReleaseError } from "../lib/client/release";
      import { startNowcastPolling } from "../lib/client/live";
      const banner = document.getElementById("release-banner");
      releaseStatus()
        .then((s) => {
          if (!banner) return;
          if (s.latest.mode === "nowcast") {
            // Valnatt: siffrorna uppdateras automatiskt (pollning var 45:e sekund).
            if (s.isNewer) document.dispatchEvent(new CustomEvent("mandatorn:newer-release", { detail: s.latest }));
            banner.innerHTML = `<p class="banner warn">Valnatt: siffrorna uppdateras automatiskt.</p>`;
            startNowcastPolling(s.latest);
          } else if (s.supersededBy) {
            banner.innerHTML = `<p class="banner warn">Siffrorna på sidan har rättats i en senare release. <a href="">Ladda om sidan</a> för de rättade värdena.</p>`;
          } else if (s.isNewer) {
            document.dispatchEvent(new CustomEvent("mandatorn:newer-release", { detail: s.latest }));
            banner.innerHTML = `<p class="banner warn">Det finns nyare data (${s.latest.generatedAt.slice(0, 10)}). Siffrorna uppdateras — <a href="">ladda om</a> för hela sidan.</p>`;
          }
        })
        .catch((e) => {
          if (banner && e instanceof ReleaseError) banner.innerHTML = `<p class="banner error">${e.message}</p>`;
        });
    </script>
  </body>
</html>
