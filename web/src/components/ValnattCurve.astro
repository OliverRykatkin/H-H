---
/** Statisk felkurva för valnatten: genomsnittligt fel per parti, råräkning mot nowcast. */
interface Props { curve: { time?: unknown; raw?: unknown; nowcast?: unknown }[] }
const rows = Astro.props.curve.map((c) => ({ t: Date.parse(String(c.time)), raw: c.raw as number | null, nc: c.nowcast as number }));
const W = 760, H = 240, L = 36, R = 12, T = 12, B = 26;
const t0 = rows[0].t, t1 = rows[rows.length - 1].t;
const yMax = Math.min(4, Math.ceil(Math.max(...rows.map((r) => Math.max(r.raw ?? 0, r.nc))) * 2) / 2);
const x = (t: number) => L + ((t - t0) / (t1 - t0)) * (W - L - R);
const y = (v: number) => T + (1 - Math.min(v, yMax) / yMax) * (H - T - B);
const line = (k: "raw" | "nc") => rows.filter((r) => r[k] != null).map((r) => `${x(r.t).toFixed(1)},${y(r[k] as number).toFixed(1)}`).join(" ");
const hours = rows.filter((r) => new Date(r.t).getMinutes() === 0);
const ticks = Array.from({ length: Math.round(yMax / 0.5) + 1 }, (_, i) => i * 0.5);
const hh = (t: number) => new Intl.DateTimeFormat("sv-SE", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Stockholm" }).format(new Date(t));
---
<figure>
  <svg class="chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Genomsnittligt fel per parti under valnatten, råräkning och nowcast">
    {ticks.map((v) => <g><line x1={L} x2={W - R} y1={y(v)} y2={y(v)} stroke="#ebebeb" /><text x={L - 6} y={y(v) + 4} text-anchor="end" font-size="11" fill="#5c5f63">{v.toFixed(1).replace(".", ",")}</text></g>)}
    {hours.map((r) => <text x={x(r.t)} y={H - 8} text-anchor="middle" font-size="11" fill="#5c5f63">{hh(r.t)}</text>)}
    <polyline points={line("raw")} fill="none" stroke="#999" stroke-width="2" />
    <polyline points={line("nc")} fill="none" stroke="#1f8f78" stroke-width="2.5" />
  </svg>
  <figcaption class="small muted">Genomsnittligt fel per parti mot slutresultatet (procentenheter). Grå = råräkning, grön = nowcast. Skalan är kapad vid {yMax.toFixed(1).replace(".", ",")} pe.</figcaption>
</figure>
