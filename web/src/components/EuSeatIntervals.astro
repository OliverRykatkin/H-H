---
/** Mandatintervall per parti ur EU-simuleringen: p5–p95 (tunn), p25–p75 (tjock), median, EU-valet 2024 (romb). */
import type { EuSimulation } from "@contracts/contracts";
import { PARTY_COLORS } from "@contracts/constants";
import { partyName } from "../lib/format";

interface Props { sim: EuSimulation; last: Record<string, number> }
const { sim, last } = Astro.props;
const rows = [...sim.parties].sort((a, b) => b.median - a.median || b.mean - a.mean);
const max = Math.max(...rows.map((r) => r.p95), ...Object.values(last)) + 2;
const W = 760, L = 150, R = 40, rowH = 30, H = rows.length * rowH + 30;
const x = (v: number) => L + (v / max) * (W - L - R);
const ticks = Array.from({ length: max + 1 }, (_, i) => i).filter((i) => i % 2 === 0);
---
<figure>
  <svg class="chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Mandat per parti med 90 % intervall">
    {ticks.map((t) => <g><line x1={x(t)} x2={x(t)} y1="4" y2={H - 22} stroke="#e2e4e0" /><text x={x(t)} y={H - 6} text-anchor="middle" font-size="11" fill="#5c5f63">{t}</text></g>)}
    {rows.map((r, i) => {
      const cy = 16 + i * rowH;
      const c = PARTY_COLORS[r.party];
      return (
        <g>
          <text x={L - 8} y={cy + 4} text-anchor="end" font-size="13">{partyName(r.party)}</text>
          <line x1={x(r.p5)} x2={x(r.p95)} y1={cy} y2={cy} stroke={c} stroke-width="3" stroke-opacity="0.45" />
          <line x1={x(r.p25)} x2={x(r.p75)} y1={cy} y2={cy} stroke={c} stroke-width="9" stroke-opacity="0.85" />
          <line x1={x(r.median)} x2={x(r.median)} y1={cy - 8} y2={cy + 8} stroke="#111" stroke-width="2" />
          {last[r.party] != null && <path d={`M${x(last[r.party])},${cy - 6} l6,6 l-6,6 l-6,-6 z`} fill="#fff" stroke="#555" />}
          <text x={x(r.p95) + 6} y={cy + 4} font-size="11" fill="#5c5f63">{r.p5}–{r.p95}</text>
        </g>
      );
    })}
  </svg>
  <figcaption class="small muted">Tunn linje = 90 % intervall, tjock = 50 %, streck = median, romb = mandat i EU-valet 2024.</figcaption>
</figure>
