---
/** Horisontell stapel över EU-valets mandat, med majoritetsmarkering (hälften + 1). */
import { PARTY_COLORS } from "@contracts/constants";
import { partyName } from "../lib/format";
import { EU_ORDER } from "../lib/eu";

interface Props { seats: Record<string, number>; total: number; caption?: string }
const { seats, total, caption } = Astro.props;
const parts = EU_ORDER.filter((p) => (seats[p] ?? 0) > 0);
const majority = Math.floor(total / 2) + 1;
function textColor(hex: string) {
  const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255)
    .map((c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));
  const L = 0.2126 * r + 0.7152 * g + 0.0722 * b;
  return 1.05 / (L + 0.05) >= (L + 0.05) / 0.05 ? "#ffffff" : "#111213";
}
---
<figure>
  <div style="position:relative">
    <div role="img" aria-label={parts.map((p) => `${partyName(p)} ${seats[p]} mandat`).join(", ")}
      style="display:flex;height:2.2rem;border-radius:4px;overflow:hidden;border:1px solid var(--c-border)">
      {parts.map((p) => (
        <div title={`${partyName(p)}: ${seats[p]}`} style={`flex:${seats[p]} 0 0;background:${PARTY_COLORS[p]};display:flex;align-items:center;justify-content:center;color:${textColor(PARTY_COLORS[p])};font-weight:700;font-size:0.8rem`}>{`${p} ${seats[p]}`}</div>
      ))}
    </div>
    <div aria-hidden="true" style={`position:absolute;top:-4px;bottom:-4px;left:${((majority - 0.5) / total) * 100}%;border-left:2px dashed #111`}></div>
  </div>
  {caption && <figcaption class="small muted">{caption}</figcaption>}
</figure>
