---
/** Enkel statisk SVG-linjegraf: serier över datum, valfri referenslinje och slutmarkörer. */
interface Series { key: string; label: string; color: string; values: (number | null)[]; final?: number | null }
interface Props { dates: string[]; series: Series[]; title: string; yMin?: number; yMax?: number; unit?: string; refLine?: number | null; step?: number }
const { dates, series, title, unit = "%", refLine = null, step = 3 } = Astro.props;
const W = 760, H = 320, L = 40, R = 60, T = 12, B = 26;
const idx: number[] = [];
for (let i = 0; i < dates.length; i += step) idx.push(i);
if (idx[idx.length - 1] !== dates.length - 1) idx.push(dates.length - 1);
const vals = series.flatMap((s) => [...idx.map((i) => s.values[i]), s.final ?? null]).filter((v): v is number => v != null);
const yMin = Astro.props.yMin ?? Math.floor(Math.min(...vals) / 5) * 5;
const yMax = Astro.props.yMax ?? Math.ceil(Math.max(...vals) / 5) * 5;
const t0 = Date.parse(dates[0]), t1 = Date.parse(dates[dates.length - 1]);
const x = (d: string) => L + ((Date.parse(d) - t0) / (t1 - t0 || 1)) * (W - L - R);
const y = (v: number) => T + (1 - (v - yMin) / (yMax - yMin || 1)) * (H - T - B);
const ticks = Array.from({ length: 6 }, (_, i) => yMin + ((yMax - yMin) / 5) * i);
const months = dates.filter((d, i) => i === 0 || d.slice(8) === "01").filter((_, i, a) => a.length <= 7 || i % 2 === 0);
const f = (n: number) => n.toFixed(1);
---
<figure>
  <svg class="chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title}>
    <title>{title}</title>
    {ticks.map((v) => <g><line x1={L} x2={W - R} y1={y(v)} y2={y(v)} stroke="#ebebeb" /><text x={L - 6} y={y(v) + 4} text-anchor="end" font-size="11" fill="#5c5f63">{Math.round(v)}{unit === "%" ? "" : ""}</text></g>)}
    {months.map((d) => <text x={x(d)} y={H - 8} font-size="11" fill="#5c5f63" text-anchor="middle">{d.slice(2, 7)}</text>)}
    {refLine != null && <line x1={L} x2={W - R} y1={y(refLine)} y2={y(refLine)} stroke="#999" stroke-dasharray="3 3" />}
    {series.map((s) => (
      <g>
        <polyline fill="none" stroke={s.color} stroke-width="2" points={idx.filter((i) => s.values[i] != null).map((i) => `${f(x(dates[i]))},${f(y(s.values[i] as number))}`).join(" ")} />
        {s.final != null && <path d={`M${x(dates[dates.length - 1]) + 10},${y(s.final) - 5} l5,5 l-5,5 l-5,-5 z`} fill={s.color} stroke="#111" />}
      </g>
    ))}
  </svg>
  <figcaption class="small muted">
    {series.map((s) => <span style="margin-right:0.9em;white-space:nowrap"><span class="swatch" style={`background:${s.color}`}></span>{s.label}</span>)}
    {series.some((s) => s.final != null) && <><br />Romb = valresultatet.</>}
  </figcaption>
</figure>
