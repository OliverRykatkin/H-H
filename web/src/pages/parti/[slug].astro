---
import Layout from "../../layouts/Layout.astro";
import Ingress from "../../components/Ingress.astro";
import TrendChart from "../../components/TrendChart.astro";
import EntityBiasTable from "../../components/EntityBiasTable.astro";
import EntityPollTable from "../../components/EntityPollTable.astro";
import { PARTIES, PARTY_COLORS, BASELINE_YEAR, NEXT_ELECTION_YEAR } from "@contracts/constants";
import * as D from "../../lib/data";
import { pct, signed, signedInt, partyName, slugify, changeClass, dateSv } from "../../lib/format";
import { partyIngress } from "../../lib/text/ingress";
import { displayPct } from "../../lib/text/scale";

export function getStaticPaths() {
  return PARTIES.map((code) => ({ params: { slug: slugify(partyName(code)) }, props: { code } }));
}
const { code } = Astro.props as { code: string };
const name = partyName(code);
const nat = D.national();
const sim = D.simulation();
const md = D.mandates();
const est = nat.estimates.find((e) => e.party === code)!;
const band = D.todayBand(code);
const sp = sim.parties.find((p) => p.party === code)!;
const seats = md.parties.find((p) => p.party === code)!;
// Officiella totala mandat i baslinjevalet = antal invalda (mandates.parties.baseline är bara fasta mandat).
const baselineTotal = (D.elected()?.members ?? []).filter((m) => m.parti === code).length || seats.baseline;
const consts = D.constituencies();
const polls = D.polls().polls;
const partyPolls = polls.filter((p) => p.shares[code] != null);
// polls.json är sorterad med senaste först: första träffen per institut är den senaste.
const latest = new Map<string, (typeof polls)[number]>();
for (const p of partyPolls) if (!latest.has(p.institute)) latest.set(p.institute, p);
const bias = D.institutes().bias.filter((b) => b.party === code);
const pZeroFixed = (c: (typeof consts)[number]) => c.seatDistribution?.[code]?.["0"] ?? null;
const description = `${name} i Mandatorns prognos: ${pct(est.share)} i dag, ${seats.total} mandat om det vore val i dag, ${displayPct(sp.pAboveThreshold)} sannolikhet att klara spärren ${NEXT_ELECTION_YEAR}.`;
const jsonLd = { "@context": "https://schema.org", "@type": "PoliticalParty", name, alternateName: code, url: new URL(Astro.url.pathname, Astro.site).href };
---
<Layout title={name} description={description} jsonLd={jsonLd}>
  <p class="small"><a href="/partier/">Partier</a> /</p>
  <h1><span class="swatch" style={`background:${PARTY_COLORS[code]}`}></span>{name}</h1>
  <Ingress text={partyIngress(code, nat, sim)} live={`party:${code}`} />

  <section class="grid grid-4" aria-label="Nyckeltal">
    <div class="card metric">
      <div class="label">Stöd i dag</div>
      <div class="value">{pct(est.share)}</div>
      <div class="sub">90 % intervall {band ? `${pct(band.p5)}–${pct(band.p95)}` : "–"}</div>
    </div>
    <div class="card metric">
      <div class="label">Förändring sedan valet {BASELINE_YEAR}</div>
      <div class={`value ${changeClass(est.change)}`}>{signed(est.change)}</div>
      <div class="sub">procentenheter (val {BASELINE_YEAR}: {pct(est.baseline)})</div>
    </div>
    <div class="card metric">
      <div class="label">Mandat om det vore val i dag</div>
      <div class="value" data-live-metric={`seats:${code}`}>{seats.total}</div>
      <div class="sub">{seats.fixed} fasta + {seats.adjustment} utjämning · {signedInt(seats.total - baselineTotal)} mot {BASELINE_YEAR} ({baselineTotal})</div>
    </div>
    <div class="card metric">
      <div class="label">Klarar spärren {NEXT_ELECTION_YEAR}</div>
      <div class="value">{displayPct(sp.pAboveThreshold)}</div>
      <div class="sub">Mandat i valet: {sp.p5}–{sp.p95} (90 %), median {sp.median}</div>
    </div>
  </section>

  <h2>Trend</h2>
  <TrendChart ts={D.timeseries()} keys={[code]} title={`Skattat stöd för ${name} sedan augusti 2022`} />

  <h2>Per valkrets</h2>
  <div class="table-scroll">
    <table>
      <caption>Röstandel och fasta valkretsmandat om det vore val i dag, jämfört med valet {BASELINE_YEAR}. Sannolikheten avser minst ett fast mandat i valet {NEXT_ELECTION_YEAR}.</caption>
      <thead><tr>
        <th scope="col">Valkrets</th><th scope="col" class="r">Andel nu</th><th scope="col" class="r">Val {BASELINE_YEAR}</th>
        <th scope="col" class="r">Förändring</th><th scope="col" class="r">Fasta mandat</th><th scope="col" class="r">{BASELINE_YEAR}</th>
        <th scope="col" class="r">Minst ett fast mandat</th>
      </tr></thead>
      <tbody>
        {consts.map((c) => {
          const now = c.now[code] ?? 0, base = c.baseline[code] ?? 0, p0 = pZeroFixed(c);
          return (
            <tr>
              <th scope="row"><a href={`/valkrets/${c.slug}/`}>{c.name}</a></th>
              <td class="r">{pct(now)}</td>
              <td class="r">{pct(base)}</td>
              <td class={`r ${changeClass(now - base)}`}>{signed(now - base)}</td>
              <td class="r">{c.fixedNow[code] ?? 0}</td>
              <td class="r">{c.fixedBaseline[code] ?? 0}</td>
              <td class="r">{p0 == null ? "–" : displayPct(1 - p0)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <h2>Senaste mätning per institut</h2>
  <div class="table-scroll">
    <table>
      <caption>Senaste mätningen från varje institut i releasen (publicerad {dateSv(nat.latestPoll)} eller tidigare).</caption>
      <thead><tr><th scope="col">Institut</th><th scope="col">Fältperiod</th><th scope="col" class="r">{name}</th><th scope="col" class="r">Mot skattningen i dag</th></tr></thead>
      <tbody>
        {[...latest.values()].sort((a, b) => a.institute.localeCompare(b.institute, "sv")).map((p) => {
          const v = p.shares[code] as number;
          return (
            <tr>
              <th scope="row"><a href={`/institut/${slugify(p.institute)}/`}>{p.institute}</a></th>
              <td class="small">{p.fieldFrom && p.fieldTo ? `${p.fieldFrom} – ${p.fieldTo}` : `publ. ${p.published}`}</td>
              <td class="r">{pct(v)}</td>
              <td class={`r ${changeClass(v - est.share)}`}>{signed(v - est.share)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  <EntityPollTable polls={partyPolls} parties={[code]} caption={`De senaste mätningarna av ${name}.`} limit={15} />

  <h2>Husbias per institut</h2>
  <p class="small muted">Hur institutens mätningar av {name} avvikit från Mandatorns trend samma dag. Positivt = institutet har mätt högre än trenden.</p>
  <EntityBiasTable rows={bias} by="institute" caption={`Husbias för ${name} (avvikelse mot Kalman-trenden).`} />
</Layout>
