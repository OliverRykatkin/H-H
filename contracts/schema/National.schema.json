        "$ref": "#/$defs/PartyEstimate"
      },
      "type": "array"
    },
    "largestParty": {
      "enum": [
        "M",
        "L",
        "C",
        "KD",
        "S",
        "V",
        "MP",
        "SD"
      ],
      "type": "string"
    },
    "latestPoll": {
      "type": "string"
    },
    "nextElection": {
      "type": "string"
    },
    "referenceDate": {
      "type": "string"
    },
    "schemaVersion": {
      "default": 1,
      "type": "integer"
    },
    "seats": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Punktprognos, totala mandat per parti",
      "type": "object"
    },
    "swing": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "Nollsummerad nationell sving sedan baslinjevalet (pp)",
      "type": "object"
    },
    "trend": {
      "items": {
        "$ref": "#/$defs/TrendRow"
      },
      "type": "array"
    }
