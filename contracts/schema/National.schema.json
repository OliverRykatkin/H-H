          "type": "string"
        },
        "pMajority": {
          "type": "number"
        },
        "parties": {
          "items": {
            "enum": [
              "M",
              "L",
              "C",
              "KD",
              "S",
              "V",
              "MP",
              "SD"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "seats": {
          "type": "integer"
        },
        "share": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "parties",
        "seats",
        "share",
        "pMajority"
      ],
      "title": "Bloc",
      "type": "object"
    },
    "PartyEstimate": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Valresultat i baslinjevalet (procent)"
        },
        "change": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "pAboveThreshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
