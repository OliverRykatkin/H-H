        "party": {
          "enum": [
            "M",
            "L",
            "C",
            "KD",
            "S",
            "V",
            "MP",
            "SD",
            "O"
          ],
          "type": "string"
        },
        "sd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Simuleringens totala σ (pp)"
        },
        "share": {
          "description": "Skattad röstandel i procent (8 partier normerade till 100; O separat)",
          "type": "number"
        }
      },
      "required": [
        "party",
        "name",
        "share",
        "baseline",
        "change"
      ],
      "title": "PartyEstimate",
      "type": "object"
    },
    "TrendRow": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "Parti- eller blocknyckel",
          "type": "string"
        },
        "lastElection": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "monthAgo": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "now": {
          "type": "number"
        },
        "yearAgo": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "name",
        "now",
        "monthAgo",
        "yearAgo",
        "lastElection"
      ],
      "title": "TrendRow",
      "type": "object"
    }
  },
  "$id": "https://data.mandatorn.se/schema/v1/National.json",
  "additionalProperties": false,
  "properties": {
    "baselineYear": {
      "type": "integer"
    },
    "belowThreshold": {
      "items": {
        "enum": [
          "M",
          "L",
          "C",
          "KD",
          "S",
          "V",
          "MP",
          "SD"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "blocs": {
      "items": {
        "$ref": "#/$defs/Bloc"
      },
      "type": "array"
    },
    "daysLeft": {
      "type": "integer"
